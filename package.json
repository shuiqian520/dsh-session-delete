{
  "name": "dsh-session-delete",
  "version": "0.3.2",
  "private": true,
  "description": "DSH 侧栏「删除此会话」+ 消息重试:永久删除会话(日志/工作区归属/内存实例/客户端列表行),并在用户消息与 AI 回复的复制按钮右侧加「重试」。",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./client": "./src/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "icon": "./icon.svg",
  "files": [
    "src",
    "locale",
    "assets",
    "screenshots.json",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test test/smoke.mjs",
    "pack": "npm pack"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "session",
    "delete",
    "retry"
  ],
  "author": "dsh-session-delete contributors",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-ui-chat"
      ]
    }
  }
}
